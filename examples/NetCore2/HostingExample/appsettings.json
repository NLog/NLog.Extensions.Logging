{
  "Logging": {
    "NLog": {
      "IncludeScopes": false,
      "ParseMessageTemplates": true,
      "CaptureMessageProperties": true
    }
  },
  "NLog": {
    "autoReload": true,
    "throwConfigExceptions": true,
    "targets": {
      "console": {
        "type": "Console",
        "layout": "${MicrosoftConsoleLayout}"
      },
      "file": {
        "type": "File",
        "fileName": "logs/app-${shortdate}.log",
        "maxArchiveFiles": 7,
        "layout": {
          "type": "MicrosoftConsoleJsonLayout",
          "includeScopes": true,
          "includeActivityIds": true
        }
      }
    },
    "rules": [
      {
        "logger": "System.*",
        "finalMinLevel": "Warning"
      },
      {
        "logger": "Microsoft.*",
        "finalMinLevel": "Warning"
      },
      {
        "logger": "Microsoft.Hosting.Lifetime*",
        "finalMinLevel": "Info"
      },
      {
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "console,file"
      }
    ]
  }
}